{
  "name": "ofone-skillchain",
  "version": "0.7.0",
  "description": "OfOne typed inquiry, causal-geometry, and adaptive Question Geometry compiler",
  "type": "module",
  "scripts": {
    "validate": "node scripts/ofone-validate.mjs examples/*.json",
    "validate:write": "node scripts/ofone-validate.mjs --write examples/*.json",
    "schema:check": "node scripts/ofone-schema-check.mjs",
    "render": "node scripts/ofone-render.mjs",
    "patch": "node scripts/ofone-patch.mjs",
    "question:check": "node scripts/ofone-question-geometry-check.mjs examples/question-geometry/causal-depth.json",
    "question:step": "node scripts/ofone-question-loop.mjs step examples/question-geometry/causal-depth.json",
    "question:landscape": "node scripts/ofone-question-loop.mjs landscape examples/question-geometry/causal-depth.json",
    "question:test": "node scripts/ofone-question-geometry-test.mjs",
    "question:benchmark": "node scripts/ofone-question-benchmark.mjs benchmarks/question-geometry/suite.json",
    "question:benchmark:write": "node scripts/ofone-question-benchmark.mjs benchmarks/question-geometry/suite.json --write",
    "voiceover": "node scripts/ofone-generate-voiceover.mjs",
    "benchmark": "node scripts/ofone-benchmark.mjs",
    "frontier:check": "node scripts/ofone-frontier-packet-check.mjs",
    "frontier:protocol:check": "node scripts/ofone-frontier-repair-protocol-check.mjs",
    "frontier:controlled:check": "node scripts/ofone-frontier-controlled-contract-check.mjs",
    "skill:install": "node scripts/ofone-install-skill.mjs",
    "skill:check": "node scripts/ofone-install-skill.mjs --check",
    "pages:check": "node scripts/ofone-pages-check.mjs",
    "research:check": "node scripts/ofone-research-check.mjs",
    "deep-research:check": "node scripts/ofone-deep-research-launch-check.mjs",
    "deep-research:payloads": "node scripts/ofone-deep-research-extension-payloads.mjs --check",
    "deep-research:payloads:write": "node scripts/ofone-deep-research-extension-payloads.mjs --write",
    "deep-research:report": "node scripts/ofone-deep-research-extension-report-check.mjs",
    "deep-research:manual-recovery": "node scripts/ofone-deep-research-manual-recovery.mjs --check",
    "deep-research:manual-recovery:scan": "node scripts/ofone-deep-research-manual-recovery.mjs --check --scan-sources",
    "deep-research:manual-recovery:write": "node scripts/ofone-deep-research-manual-recovery.mjs --write",
    "review:check": "node scripts/ofone-review-check.mjs research/review-sidecars/*.json",
    "test": "node scripts/ofone-test.mjs && node scripts/ofone-question-geometry-test.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
