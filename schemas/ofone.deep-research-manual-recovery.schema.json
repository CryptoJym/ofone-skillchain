{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cryptojym.github.io/ofone-skillchain/schemas/ofone.deep-research-manual-recovery.schema.json",
  "title": "OfOne Deep Research Manual Recovery Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "recovery_id",
    "generated_at",
    "source_surface",
    "report_path",
    "report_sha256",
    "queue_path",
    "queue_sha256",
    "payload_path",
    "payload_sha256",
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "protocol_version": {
      "const": "ofone-deep-research-manual-recovery-0.1"
    },
    "recovery_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "source_surface": {
      "const": "chrome_extension_plugin"
    },
    "report_path": {
      "$ref": "#/$defs/repoPath"
    },
    "report_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "queue_path": {
      "$ref": "#/$defs/repoPath"
    },
    "queue_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "payload_path": {
      "$ref": "#/$defs/repoPath"
    },
    "payload_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/recoveryItem"
      }
    }
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/].*"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "recoveryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "status",
        "conversation_url",
        "blocked_status",
        "recovery_reason",
        "expected_source_glob",
        "expected_raw_output_path",
        "expected_review_path",
        "required_raw_markers",
        "forbidden_recovery_methods",
        "manual_steps",
        "promotion_gate"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "awaiting_operator_export",
            "recovered"
          ]
        },
        "conversation_url": {
          "type": "string",
          "pattern": "^https://chatgpt\\.com/c/.+"
        },
        "blocked_status": {
          "const": "completed_report_visible"
        },
        "recovery_reason": {
          "type": "string",
          "minLength": 1
        },
        "expected_source_glob": {
          "type": "string",
          "minLength": 1
        },
        "expected_raw_output_path": {
          "$ref": "#/$defs/repoPath"
        },
        "expected_review_path": {
          "$ref": "#/$defs/repoPath"
        },
        "required_raw_markers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_recovery_methods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "manual_steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "promotion_gate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "raw_output_required_before_harvest",
            "local_review_required",
            "queue_payload_report_update_required",
            "commit_push_pages_required",
            "aggregate_eligible_before_review_publication"
          ],
          "properties": {
            "raw_output_required_before_harvest": {
              "const": true
            },
            "local_review_required": {
              "const": true
            },
            "queue_payload_report_update_required": {
              "const": true
            },
            "commit_push_pages_required": {
              "const": true
            },
            "aggregate_eligible_before_review_publication": {
              "const": false
            }
          }
        }
      }
    }
  }
}
