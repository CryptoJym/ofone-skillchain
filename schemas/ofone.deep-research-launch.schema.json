{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cryptojym.github.io/ofone-skillchain/schemas/ofone.deep-research-launch.schema.json",
  "title": "OfOne Chrome Extension Deep Research Launch Queue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "queue_id",
    "generated_at",
    "source_of_truth",
    "launch_surface_policy",
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "protocol_version": {
      "const": "ofone-deep-research-launch-0.1"
    },
    "queue_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "source_of_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tracker", "status_ledger", "loop"],
      "properties": {
        "tracker": { "$ref": "#/$defs/repoPath" },
        "status_ledger": { "$ref": "#/$defs/repoPath" },
        "loop": { "$ref": "#/$defs/repoPath" }
      }
    },
    "launch_surface_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_surface",
        "requires_isolated_tab",
        "supports_parallel_tabs",
        "desktop_automation_fallback_allowed",
        "blocked_status"
      ],
      "properties": {
        "primary_surface": {
          "const": "chrome_extension_plugin"
        },
        "requires_isolated_tab": {
          "const": true
        },
        "supports_parallel_tabs": {
          "const": true
        },
        "desktop_automation_fallback_allowed": {
          "const": false
        },
        "blocked_status": {
          "const": "prepared_blocked_chrome_extension_unavailable"
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/launchItem" }
    }
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/].*"
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "launchItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "batch_id",
        "case_id",
        "arm",
        "model_family",
        "repeat",
        "packet_path",
        "prompt_anchor",
        "status",
        "blocked_reason",
        "required_launch_proof",
        "disallowed_surfaces",
        "expected_output_path",
        "expected_review_path",
        "aggregate_policy"
      ],
      "properties": {
        "item_id": { "type": "string", "minLength": 1 },
        "batch_id": { "type": "string", "minLength": 1 },
        "case_id": { "type": "string", "minLength": 1 },
        "arm": {
          "enum": ["direct_answer", "light_structured", "full_ofone"]
        },
        "model_family": {
          "enum": ["agentic_coding", "frontier_reasoning"]
        },
        "repeat": {
          "type": "integer",
          "minimum": 1
        },
        "packet_path": { "$ref": "#/$defs/repoPath" },
        "prompt_anchor": { "type": "string", "minLength": 1 },
        "status": {
          "enum": [
            "prepared_not_launched",
            "prepared_blocked_chrome_extension_unavailable",
            "launched",
            "active_researching",
            "harvested",
            "reviewed",
            "rejected",
            "blocked"
          ]
        },
        "blocked_reason": { "type": "string", "minLength": 1 },
        "required_launch_proof": { "$ref": "#/$defs/nonEmptyStringArray" },
        "disallowed_surfaces": { "$ref": "#/$defs/nonEmptyStringArray" },
        "expected_output_path": { "$ref": "#/$defs/repoPath" },
        "expected_review_path": { "$ref": "#/$defs/repoPath" },
        "aggregate_policy": {
          "enum": [
            "not_eligible_until_harvest_review_publication",
            "replacement_only_after_local_validation",
            "aggregate_eligible_after_review"
          ]
        },
        "conversation_url": {
          "type": "string",
          "minLength": 1
        },
        "launch_proof_path": {
          "$ref": "#/$defs/repoPath"
        }
      }
    }
  }
}
