{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cryptojym.github.io/ofone-skillchain/schemas/ofone.deep-research-extension-report.schema.json",
  "title": "OfOne Chrome Extension Deep Research Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "report_id",
    "generated_at",
    "payload_path",
    "payload_sha256",
    "source_surface",
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "protocol_version": {
      "const": "ofone-deep-research-extension-report-0.1"
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "payload_path": {
      "$ref": "#/$defs/repoPath"
    },
    "payload_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_surface": {
      "enum": [
        "chrome_extension_plugin",
        "codex_tool_discovery"
      ]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/reportItem"
      }
    }
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/].*"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "reportItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "tab_lane",
        "status",
        "extension_control",
        "aggregate_policy_after_report"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "tab_lane": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "observed_blocked",
            "launch_ready",
            "launched",
            "active_researching",
            "observation_blocked",
            "completed_report_visible",
            "harvested",
            "rejected"
          ]
        },
        "extension_control": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "surface",
            "callable_namespace",
            "isolated_tab_verified",
            "desktop_automation_used"
          ],
          "properties": {
            "surface": {
              "enum": [
                "chrome_extension_plugin",
                "unavailable",
                "disallowed_desktop_automation"
              ]
            },
            "callable_namespace": {
              "type": ["string", "null"]
            },
            "isolated_tab_verified": {
              "type": "boolean"
            },
            "desktop_automation_used": {
              "const": false
            }
          }
        },
        "launch_proof": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "conversation_url",
            "model_label",
            "reasoning_label",
            "deep_research_enabled",
            "plan_title",
            "start_or_countdown_action",
            "active_state",
            "stop_control_visible",
            "observed_at"
          ],
          "properties": {
            "conversation_url": {
              "type": "string",
              "pattern": "^https://chatgpt\\.com/c/.+"
            },
            "model_label": {
              "type": "string",
              "minLength": 1
            },
            "reasoning_label": {
              "type": "string",
              "minLength": 1
            },
            "deep_research_enabled": {
              "const": true
            },
            "plan_title": {
              "type": "string",
              "minLength": 1
            },
            "start_or_countdown_action": {
              "type": "string",
              "minLength": 1
            },
            "active_state": {
              "type": "string",
              "minLength": 1
            },
            "stop_control_visible": {
              "const": true
            },
            "observed_at": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "harvest_proof": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "completed_report_visible",
            "report_title",
            "raw_output_path",
            "raw_output_sha256"
          ],
          "properties": {
            "completed_report_visible": {
              "const": true
            },
            "report_title": {
              "type": "string",
              "minLength": 1
            },
            "exported_markdown_path": {
              "type": "string",
              "minLength": 1
            },
            "raw_output_path": {
              "$ref": "#/$defs/repoPath"
            },
            "raw_output_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "blocker": {
          "type": "string",
          "minLength": 1
        },
        "latest_observation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observed_at",
            "conversation_url",
            "browser_surface",
            "iframe_present",
            "iframe_text_readable",
            "completed_report_visible",
            "stop_control_visible",
            "active_state_visible",
            "response_text_available",
            "visible_state",
            "next_action"
          ],
          "properties": {
            "observed_at": {
              "type": "string",
              "minLength": 1
            },
            "conversation_url": {
              "type": "string",
              "pattern": "^https://chatgpt\\.com/c/.+"
            },
            "browser_surface": {
              "const": "chrome_extension_plugin"
            },
            "iframe_present": {
              "type": "boolean"
            },
            "iframe_text_readable": {
              "type": "boolean"
            },
            "completed_report_visible": {
              "type": "boolean"
            },
            "stop_control_visible": {
              "type": "boolean"
            },
            "active_state_visible": {
              "type": "boolean"
            },
            "response_text_available": {
              "type": "boolean"
            },
            "visible_state": {
              "type": "string",
              "minLength": 1
            },
            "next_action": {
              "enum": [
                "observe_again_without_relaunch",
                "harvest_when_completed_report_visible",
                "review_and_publish_harvested_output",
                "operator_manual_recovery_required"
              ]
            }
          }
        },
        "aggregate_policy_after_report": {
          "enum": [
            "not_eligible_until_harvest_review_publication",
            "not_eligible_blocked",
            "eligible_only_after_local_review_and_publication"
          ]
        }
      }
    }
  }
}
